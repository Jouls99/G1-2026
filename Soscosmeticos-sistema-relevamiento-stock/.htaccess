# Configuración Apache para el proyecto PHP
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /proyecto/

    # Redirección de endpoints API limpios
    RewriteRule ^api/users/?$ api/users.php [L,QSA]
    RewriteRule ^api/inventario/?$ api/inventario.php [L,QSA]
    RewriteRule ^api/ventas/?$ api/ventas.php [L,QSA]
    RewriteRule ^api/auth/?$ api/auth.php [L,QSA]

    # Redirecciones para compatibilidad con nombres antiguos
    RewriteRule ^prueba2\.html$ index.php [R=301,L]
    RewriteRule ^ControlStock\.html$ control_stock.php [R=301,L]
    RewriteRule ^informe\.html$ informe.php [R=301,L]
    RewriteRule ^registroinicio\.html$ login.php [R=301,L]
</IfModule>

# Proteger archivos de datos sensibles de acceso directo
<FilesMatch "^(users\.json|inventario\.json|ventas\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Configurar Charset UTF-8 por defecto
AddDefaultCharset UTF-8
